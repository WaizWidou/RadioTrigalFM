// ══════════════════════════════════════════════════════════════════════
// RADIO TRIGAL FM — Reglas de seguridad de Firestore
// ══════════════════════════════════════════════════════════════════════
// Esto NO es un fichero que el juego cargue: hay que copiar y pegar su
// contenido en la Consola de Firebase → tu proyecto → Firestore Database
// → pestaña "Reglas" → sustituir todo lo que haya → "Publicar".
//
// Qué hacen estas reglas:
//   - Cualquiera puede LEER la colección "leaderboard" (para que se vea
//     el top 50 de cada categoría sin necesidad de iniciar sesión).
//   - Cualquiera puede ESCRIBIR una entrada, pero solo si tiene
//     exactamente esta forma: username (texto, máx. 16 caracteres),
//     avatarId (texto), updatedAt (número) y, opcionalmente, uno o
//     varios de level / infiniteScore / storyScore (números enteros
//     entre 0 y 999999). Son opcionales porque leaderboard.js actualiza
//     (con merge) solo el campo de la categoría que mejoró, sin volver
//     a mandar los otros dos; esto evita que alguien mande, por
//     accidente o aposta, datos con otra forma que rompa la pantalla de
//     Clasificaciones.
//   - Nadie puede borrar entradas directamente desde el navegador.
//
// ⚠️ Aviso honesto: como el juego no tiene sistema de cuentas/login,
// estas reglas no pueden comprobar que una puntuación sea "de verdad"
// (alguien con conocimientos técnicos podría, en teoría, mandar una
// puntuación falsa muy alta saltándose el juego). Para una clasificación
// 100% a prueba de trampas haría falta autenticación de jugadores y
// validar las puntuaciones desde un servidor (p. ej. Cloud Functions),
// que es un paso bastante más grande. Si más adelante te preocupa esto,
// dímelo y lo vemos.
// ══════════════════════════════════════════════════════════════════════
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{playerId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['username', 'avatarId', 'level', 'infiniteScore', 'storyScore', 'updatedAt'])
                   && request.resource.data.username is string
                   && request.resource.data.username.size() <= 16
                   && request.resource.data.avatarId is string
                   && request.resource.data.updatedAt is int
                   && (!('level' in request.resource.data)
                       || (request.resource.data.level is int && request.resource.data.level >= 0 && request.resource.data.level <= 999999))
                   && (!('infiniteScore' in request.resource.data)
                       || (request.resource.data.infiniteScore is int && request.resource.data.infiniteScore >= 0 && request.resource.data.infiniteScore <= 999999))
                   && (!('storyScore' in request.resource.data)
                       || (request.resource.data.storyScore is int && request.resource.data.storyScore >= 0 && request.resource.data.storyScore <= 999999));
      allow delete: if false;
    }
    // Cualquier otra colección queda bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
